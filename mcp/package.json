{
  "name": "supericons-mcp",
  "version": "0.4.0",
  "description": "MCP server for SuperIcons: search icons, animate them with Motion Lab, and access Pro workflow tools",
  "type": "module",
  "bin": {
    "supericons-mcp": "index.js"
  },
  "main": "index.js",
  "files": [
    "CHANGELOG.md",
    "auth.js",
    "converter.js",
    "generated/motion-lab-baseline.json",
    "hosted-search-client.js",
    "index.js",
    "material-export.js",
    "motion-lab-client.js",
    "motion-lab.js",
    "public/product-facts.json",
    "recommend-icons.js",
    "runtime/converter-workflow.js",
    "runtime/generated-search-intent-rules.js",
    "runtime/icon-semantic-aliases.js",
    "runtime/icon-taxonomy-seed.js",
    "runtime/public-metadata-sanitizer.js",
    "runtime/search-intent-core.js",
    "search.js",
    "semantic-registry.js",
    "telemetry.js",
    "variant-support.js",
    "workflow-access.js"
  ],
  "scripts": {
    "start": "node index.js",
    "verify:package": "node ../scripts/build-motion-lab-mcp-artifacts.mjs && node ../scripts/verify-motion-lab-mcp-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@neplex/vectorizer": "^0.0.5",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^3.24.0"
  }
}

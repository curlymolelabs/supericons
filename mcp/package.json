{
  "name": "@supericons/mcp",
  "version": "0.4.19-beta.0",
  "mcpName": "io.github.curlymolelabs/supericons",
  "description": "MCP server for Supericons: multilingual semantic SVG icon search and recommendations for AI coding agents.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curlymolelabs/supericons.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "supericons-mcp": "index.js"
  },
  "main": "index.js",
  "files": [
    "CHANGELOG.md",
    "auth.js",
    "converter.js",
    "generated/motion-lab-baseline.json",
    "generated/mcp-output-locales.json",
    "hosted-search-client.js",
    "index.js",
    "library-capabilities.js",
    "material-export.js",
    "material-hydration.js",
    "mcp-output-localization.js",
    "motion-lab-client.js",
    "motion-lab.js",
    "public/icon-index.json",
    "public/icon-index-solid.json",
    "public/material-export-manifest.json",
    "public/cjk-search-terms.json",
    "public/multilingual-search-aliases.json",
    "public/product-facts.json",
    "public-icon-preview.js",
    "preview-icons.js",
    "release-channel.js",
    "recommend-icons.js",
    "remote-server.js",
    "server.json",
    "runtime/converter-workflow.js",
    "runtime/cjk-search-core.js",
    "runtime/generated-search-intent-graph.js",
    "runtime/generated-search-intent-rules.js",
    "runtime/generated-search-ranking-policy.js",
    "runtime/icon-semantic-aliases.js",
    "runtime/supericons-ai-taxonomy.js",
    "runtime/icon-taxonomy-seed.js",
    "runtime/public-metadata-sanitizer.js",
    "runtime/search-query-frame.js",
    "runtime/search-intent-core.js",
    "runtime/search-ranking-policy.js",
    "search.js",
    "semantic-registry.js",
    "telemetry.js",
    "usage-dedupe.js",
    "variant-support.js",
    "workflow-access.js"
  ],
  "scripts": {
    "start": "node index.js",
    "start:remote": "node remote-server.js",
    "verify:public-safety": "node ../scripts/verify-public-safety.mjs --verbose",
    "prepublishOnly": "npm run verify:public-safety && node ../scripts/verify-mcp-preview-icons-image.mjs && npm run verify:package",
    "verify:package": "node ../scripts/build-motion-lab-mcp-artifacts.mjs && node ../scripts/verify-motion-lab-mcp-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@neplex/vectorizer": "^0.0.5",
    "@resvg/resvg-js": "^2.6.2",
    "express": "^5.2.1",
    "zod": "^3.24.0"
  }
}

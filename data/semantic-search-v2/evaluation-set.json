          "acceptable_families": ["select", "dropdown", "list select"]
        },
        {
          "case_id": "parity-magnifier",
          "query": "magnifier",
          "task": "Choose an icon for a search interface.",
          "slot": "magnifier",
          "intent_type": "literal_object",
          "surfaces": ["search_icons", "recommend_icons"],

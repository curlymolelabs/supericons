{
  "schema_version": "semantic-search-v2-evaluation-set-2",
  "description": "Public-safe evaluation cases for Supericons Semantic Search v2. These fixtures protect exact search, long natural-language concepts, localized concepts, negative meaning separation, recommendation slots, library behavior, and shared query understanding before production ranking changes.",
  "target_case_count": 225,
  "default_review_status": "legacy_seed_pending_owner_confirmation",
  "review_policy": "Public-safe seeds may enter the candidate suite, but expected families and unacceptable results require owner review before they count toward a release gate.",
  "query_groups": [
    {
      "id": "brand_logo_exact",
      "purpose": "Protect exact AI and developer tool logo discovery.",
      "review_status": "owner_reviewed",
      "queries": [
        {
          "case_id": "legacy-brand-xai",
          "query": "xai",
          "intent_type": "brand_logo",
          "expected_top_icon_ids": ["si:x-ai"],
          "acceptable_families": ["xai", "x.ai", "grok"]
        },
        {
          "case_id": "legacy-brand-xai-logo",
          "query": "x.ai logo",
          "intent_type": "brand_logo",
          "expected_top_icon_ids": ["si:x-ai"],
          "acceptable_families": ["xai", "x.ai", "grok"]
        },
        {
          "case_id": "legacy-brand-grok-ai-logo",
          "query": "grok ai logo",
          "intent_type": "brand_logo",
          "expected_top_icon_ids": ["si:x-ai"],
          "acceptable_families": ["xai", "x.ai", "grok"]
        },
        {
          "case_id": "legacy-brand-openai-codex",
          "query": "openai codex",
          "intent_type": "brand_logo",
          "expected_top_icon_ids": ["si:openai-codex-app"],
          "acceptable_families": ["codex", "openai codex", "coding agent"]
        },
        {
          "case_id": "legacy-brand-lovable",
          "query": "lovable",
          "intent_type": "ambiguous_concept",
          "surfaces": ["search_icons"],
          "brand_match_class": "ambiguous_exact",
          "expected_brand_behavior": "brand_permitted_top_and_shares_with_concept",
          "expected_outcome": "interpretation_diversity",
          "allowed_top_icon_ids": ["si:lovable"],
          "interpretation_family_ids": ["brand_identity", "love_affection"],
          "required_interpretation_families_top_8": ["brand_identity", "love_affection"],
          "minimum_distinct_families_top_8": 2,
          "acceptable_families": ["lovable brand", "love", "heart", "favorite", "affection"]
        },
        {
          "case_id": "legacy-brand-base44",
          "query": "base44",
          "intent_type": "brand_logo",
          "expected_top_icon_ids": ["si:base44"],
          "acceptable_families": ["base44", "ai app builder"]
        },
        {
          "case_id": "legacy-brand-kickbacks-ai",
          "query": "kickbacks ai",
          "intent_type": "brand_logo",
          "expected_top_icon_ids": ["si:kickbacks-ai"],
          "acceptable_families": ["kickbacks", "affiliate", "creator monetization"]
        }
      ]
    },
    {
      "id": "long_natural_language",
      "purpose": "Measure whether long phrases resolve to useful visual families instead of weak standalone words.",
      "review_status": "owner_reviewed",
      "queries": [
        {
          "case_id": "legacy-long-license-plate",
          "query": "license plate",
          "intent_type": "compound_concept",
          "expected_gap_type": "new_icon_gap",
          "acceptable_families": ["license plate", "scan", "camera", "vehicle", "car", "ocr"],
          "related_families": ["scan", "camera", "vehicle", "car", "ocr"],
          "avoid_families": ["legal license", "license document", "dinner plate", "food"]
        },
        {
          "case_id": "legacy-long-license-plate-recognition",
          "query": "license plate recognition camera scan car",
          "intent_type": "compound_concept",
          "expected_gap_type": "new_icon_gap",
          "acceptable_families": ["license plate scan", "traffic camera", "ocr", "camera", "vehicle"],
          "related_families": ["car"],
          "insufficient_families": ["car"],
          "avoid_families": ["legal license", "license document", "dinner plate", "food"]
        },
        {
          "case_id": "legacy-long-cursor-ai-logo",
          "query": "cursor ai code editor logo",
          "intent_type": "brand_logo",
          "expected_gap_type": "library_gap",
          "acceptable_families": ["cursor", "cursor brand", "code editor"],
          "related_families": ["terminal", "codex", "trae", "opencode"],
          "identity_substitution_allowed": false,
          "avoid_families": ["barcode"]
        },
        {
          "case_id": "legacy-long-vercel-v0-logo",
          "query": "vercel v0 ai app builder logo",
          "intent_type": "brand_logo",
          "expected_gap_type": "library_gap",
          "acceptable_families": ["v0", "vercel"],
          "related_families": ["app builder", "base44", "bolt", "lovable"],
          "identity_substitution_allowed": false
        },
        {
          "case_id": "legacy-long-neck-pain-person",
          "query": "neck pain person",
          "intent_type": "compound_concept",
          "expected_gap_type": "new_icon_gap",
          "acceptable_families": ["neck", "body pain", "person in pain"],
          "related_families": ["person", "body", "pain", "accessibility", "activity"],
          "insufficient_families": ["person", "activity"]
        },
        {
          "case_id": "legacy-long-dream-interpretation",
          "query": "dream interpretation moon star eye mystical",
          "intent_type": "abstract_metaphor",
          "expected_gap_type": "new_icon_gap",
          "acceptable_families": ["dream", "mystical", "moon", "star", "eye", "sparkles"],
          "required_signal_families": ["dream", "mystical"]

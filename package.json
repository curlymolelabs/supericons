{
  "name": "supericons",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SuperIcons: 60K+ free icons, AI search, variable font axes, component export, container preview.",
  "scripts": {
    "dev": "vite",
    "build:material-export-manifest": "node scripts/build-material-export-manifest.js",
    "build:icon-taxonomy-seed": "node scripts/export-icon-taxonomy-seed.mjs",
    "build:admin-html": "node scripts/build-admin-html.mjs",
    "build:sanitize-public-pack-metadata": "node scripts/sanitize-public-pack-metadata.js",
    "build:motion-lab-mcp-artifacts": "node scripts/build-motion-lab-mcp-artifacts.mjs",
    "verify:motion-lab-mcp-clean-install": "node scripts/verify-motion-lab-mcp-clean-install.mjs",
    "verify:converter-mcp-clean-install": "node scripts/verify-converter-mcp-clean-install.mjs",
    "verify:converter-quality-fixtures": "node scripts/verify-converter-quality-fixtures.mjs",
    "verify:motion-lab-hosted-fallback": "node scripts/verify-motion-lab-hosted-fallback.mjs",
    "verify:motion-lab-hosted-live": "node scripts/verify-motion-lab-hosted-live.mjs",
    "verify:motion-lab-negative-paths": "node scripts/verify-motion-lab-negative-paths.mjs",
    "verify:motion-lab-rate-limits": "node scripts/verify-motion-lab-rate-limits.mjs",
    "verify:motion-lab-presets": "node scripts/verify-motion-lab-preset-parity.mjs",
    "verify:motion-lab-agent-metadata": "node scripts/verify-motion-lab-agent-metadata.mjs",
    "verify:icon-grid-behavior": "node scripts/verify-icon-grid-behavior.mjs",
    "verify:search-query-fixtures": "node scripts/verify-search-query-fixtures.mjs",
    "verify:search-catalog-sync": "node scripts/verify-search-catalog-sync.mjs",
    "verify:hosted-search-engine": "node scripts/verify-hosted-search-engine.mjs",
    "backfill:subscription-period-ends": "node scripts/backfill-subscription-current-period-ends.mjs",
    "sync:search-catalog": "node scripts/sync-search-catalog-to-supabase.mjs",
    "seed:private-search-manifests": "node scripts/seed-private-search-manifests.mjs",
    "seed:material-owned-cache": "node scripts/seed-material-owned-cache.js",
    "build:bundles": "node scripts/build-collection-bundles.js",
    "converter:proof-service": "node tools/converter-proof-service/server.mjs",
    "converter:proof-smoke": "node tools/converter-proof-service/smoke-client.mjs",
    "build": "npm run build:admin-html && npm run build:material-export-manifest && npm run build:sanitize-public-pack-metadata && npm run build:motion-lab-mcp-artifacts && npm run build:bundles && npm run verify:motion-lab-presets && npm run verify:motion-lab-agent-metadata && vite build && node scripts/cleanup-dist-admin-artifacts.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@tabler/icons": "^3.40.0",
    "bootstrap-icons": "^1.13.1",
    "feather-icons": "^4.29.2",
    "heroicons": "^2.2.0",
    "iconoir": "^7.11.0",
    "ionicons": "^8.0.13",
    "lucide-static": "^0.577.0",
    "mingcute_icon": "^2.9.71",
    "simple-icons": "^16.12.0",
    "supabase": "^2.92.1",
    "vite": "^6.2.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "dependencies": {
    "@neplex/vectorizer": "^0.0.5",
    "@resvg/resvg-js": "^2.6.2",
    "vectortracer": "^0.1.2"
  }
}

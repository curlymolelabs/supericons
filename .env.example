# Browser (Vite) hosted search configuration
VITE_SUPABASE_URL=https://kcjmkakdhsqplvasgkjv.supabase.co
VITE_SUPERICONS_SEARCH_ENGINE_URL=https://kcjmkakdhsqplvasgkjv.supabase.co/functions/v1/search-icons
VITE_SUPERICONS_WEB_SEARCH_TELEMETRY_URL=https://kcjmkakdhsqplvasgkjv.supabase.co/functions/v1/web-search-telemetry
VITE_SUPERICONS_SEARCH_ENGINE_REQUIRE_JWT=true
# Must be legacy anon JWT when REQUIRE_JWT=true
VITE_SUPERICONS_SEARCH_ENGINE_ANON_KEY=

# MCP public product configuration
# Public MCP users should not need any Supabase credential.
SUPABASE_URL=https://kcjmkakdhsqplvasgkjv.supabase.co
SUPERICONS_API_KEY=

# Internal MCP hosted-search debugging only
# Do not document these for public MCP setup.
SUPERICONS_MCP_SEARCH_URL=https://kcjmkakdhsqplvasgkjv.supabase.co/functions/v1/mcp-search
# Set this only when the selected service supports grouped requests. A custom
# individual URL without this value keeps recommendation searches individual.
SUPERICONS_MCP_GROUPED_SEARCH_URL=https://kcjmkakdhsqplvasgkjv.supabase.co/functions/v1/mcp-search-grouped
SUPERICONS_INTERNAL_HOSTED_DEBUG=false
SUPABASE_ANON_KEY=
SUPERICONS_SEARCH_ENGINE_URL=https://kcjmkakdhsqplvasgkjv.supabase.co/functions/v1/search-icons
SUPERICONS_SEARCH_ENGINE_REQUIRE_JWT=true
SUPERICONS_SEARCH_ENGINE_ANON_KEY=

# Trusted search telemetry services
# Keep both secrets private. Use at least 32 random characters for each.
SUPERICONS_CONTROLLED_RUN_SECRET=
SUPERICONS_TELEMETRY_HASH_SECRET=
SUPERICONS_PRODUCTION_WEB_HOSTS=supericons.dev,www.supericons.dev
